# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="AQ.Ab8RN6J8Nms9Tej3N7mGsgZ1mQfZr2EoBX-o0gwy-JzXhZskBQ"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Firebase (auth + cloud note sync) ---
# Optional while you're developing: Voxnote runs fine without these, using
# on-device accounts and local-only notes. Add them once you've created a
# Firebase project to switch on real sign-up/login, Google sign-in, and
# cross-device note sync. See BACKEND_SETUP.md for step-by-step setup.
# These must be prefixed VITE_ so Vite exposes them to the browser bundle —
# they are Firebase's public client config, not secrets.
VITE_FIREBASE_API_KEY="AIzaSyC9syKhaShNSurMwqdA_TNwSF0b9Ekgyjo"
VITE_FIREBASE_AUTH_DOMAIN="voxnote-12647.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="voxnote-12647"
VITE_FIREBASE_STORAGE_BUCKET="voxnote-12647.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="250878817910"
VITE_FIREBASE_APP_ID="1:250878817910:web:4c342a08a06e22c0fa5157"

# --- Paystack (Pro subscription billing) ---
# Optional while developing — the "Start 7-Day Free Trial" button falls back
# to a simulated instant upgrade if these aren't set. Add them to switch on
# real Paystack Checkout. See BACKEND_SETUP.md for step-by-step setup.
# Note: unlike some providers, Paystack doesn't use a separate webhook
# secret — signatures are verified with this same secret key.
PAYSTACK_SECRET_KEY="sk_test_..."
PAYSTACK_PLAN_MONTHLY="PLN_..."
PAYSTACK_PLAN_ANNUAL="PLN_..."

# --- Firebase Admin (server-side only) ---
# Used only to record confirmed Paystack payments in Firestore. Paste the
# ENTIRE contents of your Firebase service account JSON as one line here.
# Get it from Firebase console -> Project Settings -> Service Accounts ->
# Generate new private key. NEVER commit this or expose it to the browser.
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...", ...}'
