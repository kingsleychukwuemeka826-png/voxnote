# --- Gemini AI (server-side only) ---
# Create/manage your Gemini API key in Google AI Studio, then add it to
# Render -> Environment as GEMINI_API_KEY. Never expose this key with VITE_.
GEMINI_API_KEY=""

# Public URL of the deployed Voxnote site. Used for billing callbacks.
APP_URL="https://your-voxnote-domain.onrender.com"

# --- Firebase (auth + cloud note sync) ---
# These are Firebase's public web-app configuration values. They are safe to
# expose in the browser and therefore use the VITE_ prefix.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# --- Paystack (Pro subscription billing) ---
# Use sk_test_ + test plan codes while testing. Switch to sk_live_ + live
# plan codes only after the Paystack account is ready for production.
PAYSTACK_SECRET_KEY="sk_test_..."
PAYSTACK_PLAN_MONTHLY="PLN_..."
PAYSTACK_PLAN_ANNUAL="PLN_..."

# --- Firebase Admin (server-side only) ---
# Entire Firebase service-account JSON, stored only as a Render secret.
# NEVER commit the real value to GitHub or expose it to the browser.
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...", ...}'
